# ==============================================================================
# Fox Next — Automation Control & Smart Support Bot Configuration Template
# Copy this file to `.env` and fill in your own credentials locally.
# Never commit real tokens, API keys, or passwords to version control.
# ==============================================================================

# --- Control Panel Hook (Self-Hosted / Linux Smart Support Bot) ---
CONTROL_PANEL_URL=https://foxnext.online
CONTROL_PANEL_TOKEN=
CONTROL_PANEL_ROOT=

# --- Telegram Smart Support Bot ---
TELEGRAM_BOT_TOKEN=
OWNER_ADMIN_ID=
BOT_ADMIN_IDS=
BOT_DISPLAY_NAME=Smart Support Bot

# --- OpenAI-Compatible / BYOK LLM Endpoint (Desktop / Self-Hosted) ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
AI_MODEL=gemini-3-flash-preview
AI_TEMPERATURE=0.4

# --- Optional Channels & Jobs ---
NIGHTLY_ENABLED=false
NIGHTLY_SUPPORT_CHAT_ID=
SOCIAL_NEWS_ENABLED=false
SOCIAL_NEWS_CHAT_ID=
CONVO_ANALYSIS_ENABLED=false

# --- Local ComfyUI Bridge (Optional Windows Desktop Local-First Render) ---
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
